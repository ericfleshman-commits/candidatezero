<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CandidateZero, the verified GTM jobs board</title>
<link rel="stylesheet" href="board.css">
</head>
<body>
<div class="wrap">
<header>
  <h1>CandidateZero</h1>
  <p class="tagline">A verified board of GTM engineering, RevOps and revenue systems roles,
  plus adjacent titles worth a look. One listing rule for everyone alike: the title
  fits the family and the posting is live on the employer's own applicant tracking system.
  Comp appears when the employer publishes it.</p>
  <div class="stats">
    <div class="tile"><span class="label">Company boards read</span><span class="value">{{ "{:,}".format(report.boards_read) }}</span></div>
    <div class="tile"><span class="label">Postings read this week</span><span class="value">{{ "{:,}".format(report.postings_read) }}</span></div>
    <div class="tile"><span class="label">Roles verified live right now</span><span class="value">{{ "{:,}".format(report.verified_live) }}</span></div>
    <div class="tile"><span class="label">Roles closed this week</span><span class="value">{{ "{:,}".format(report.closed_this_week) }}</span></div>
    <div class="tile"><span class="label">Last run</span><span class="value small">{{ report.last_run }}</span></div>
  </div>
</header>
<main>
{% macro open_rows(rows) %}
<div class="scroll">
<table>
  <thead>
    <tr><th>Company</th><th>Role</th><th>Comp</th><th>Location</th><th>Source</th><th>Posted</th><th></th></tr>
  </thead>
  <tbody>
  {% for row in rows %}
    <tr class="role">
      <td class="company">{{ row.company }}</td>
      <td>{{ row.title }}{% if row.mirrors %}<span class="note">{{ row.mirrors }} duplicate {{ "posting" if row.mirrors == 1 else "postings" }} on other boards collapsed into this one</span>{% endif %}</td>
      <td class="num">{{ row.comp_band or "not published" }}</td>
      <td>{{ row.location }}</td>
      <td>{{ row.vendor }}</td>
      <td class="num">{{ row.posted }}</td>
      <td><a href="{{ row.url }}">Apply</a></td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% endmacro %}
<section>
  <h2>New this week <span class="count">{{ report.new_this_week | length }}</span></h2>
  {% if report.new_this_week %}
  {{ open_rows(report.new_this_week) }}
  {% else %}
  <p class="empty">No new roles this week. A quiet week is published honestly, not padded.</p>
  {% endif %}
</section>
<section>
  <h2>Still open <span class="count">{{ report.still_open | length }}</span></h2>
  {% if report.still_open %}
  {{ open_rows(report.still_open) }}
  {% else %}
  <p class="empty">Nothing carried over from earlier weeks.</p>
  {% endif %}
</section>
<section>
  <h2>Closed recently <span class="count">{{ report.closed_recently | length }}</span></h2>
  {% if report.closed_recently %}
  <p class="note">Roles that disappeared from their employer's board in the last 7 days. If you
  sent an application to one of these and heard nothing, the silence may not be about you.</p>
  <div class="scroll">
  <table>
    <thead>
      <tr><th>Company</th><th>Role</th><th>Comp</th><th>Location</th><th>Source</th><th>Posted</th><th>Closed</th></tr>
    </thead>
    <tbody>
    {% for row in report.closed_recently %}
      <tr class="role">
        <td class="company">{{ row.company }}</td>
        <td>{{ row.title }}</td>
        <td class="num">{{ row.comp_band or "not published" }}</td>
        <td>{{ row.location }}</td>
        <td>{{ row.vendor }}</td>
        <td class="num">{{ row.posted }}</td>
        <td class="num">{{ row.closed }}, open {{ row.days_open }} {{ "day" if row.days_open == 1 else "days" }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% else %}
  <p class="empty">No roles closed in the last 7 days on the boards we watch.</p>
  {% endif %}
</section>
</main>
<footer>
  <p>Every listing above was re-verified on the employer's own applicant tracking system
  during the most recent nightly run. The engine never applies for anyone.</p>
  <p class="note">Generated {{ report.generated }}. Apply links go straight to the employer,
  never through an aggregator.</p>
</footer>
</div>
</body>
</html>
